   "source": [
    "import pandas as pd\n",
    "\n",
    "# Wczytaj plik CSV\n",
    "df = pd.read_csv(\"mecz_statystyki.csv\")\n",
    "\n",
    "# Przykład: posortuj po liczbie bramek\n",
    "print(df.sort_values(\"Goals\", ascending=False)[[\"Team\", \"Player\", \"Goals\"]])\n",
    "\n",
    "# Przykład: wyświetl zawodników z min. 1 asystą\n",
    "print(df[df[\"Assists\"] > 0][[\"Team\", \"Player\", \"Assists\"]])\n",
    "\n",
    "# Przykład: podsumowanie skuteczności podań (jeśli chcesz rozbić na liczby)\n",
    "def extract_pass_accuracy(pass_str):\n",
    "    try:\n",
    "        percent = pass_str.split(\"(\")[-1].replace(\"%)\", \"\")\n",
    "        return float(percent)\n",
    "    except:\n",
    "        return None\n",
    "\n",
    "df[\"Pass Accuracy %\"] = df[\"Passes\"].apply(extract_pass_accuracy)\n",
    "print(df[[\"Player\", \"Pass Accuracy %\"]])"
   ]
  },
